# OpenWA — immagine all-in-one per Coolify
# Include: API (2785) + AI Service (3100) + Dashboard (nginx :80)

# ===== Stage 1: Build API =====
FROM node:22-slim AS api-builder

WORKDIR /app

# Build-time: serve devDependencies (Coolify può iniettare NODE_ENV=production)
ENV NODE_ENV=development

RUN apt-get update && apt-get install -y python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ===== Stage 2: Build Dashboard =====
FROM node:20-alpine AS dashboard-builder

WORKDIR /app

ENV NODE_ENV=development

COPY dashboard/package*.json ./
RUN npm ci

COPY dashboard/ ./
RUN npm run build

# ===== Stage 3: Production =====
FROM node:22-slim AS production

RUN apt-get update && apt-get install -y \
    nginx \
    chromium \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    dumb-init \
    wget \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV NODE_ENV=production
# Porta esposta a Coolify (nginx). Deve coincidere con "Ports Exposes".
ENV PORT=80

WORKDIR /app

# API dependencies + build
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=api-builder /app/dist ./dist

# AI service
COPY ai-service/package*.json ./ai-service/
RUN cd ai-service && npm ci --omit=dev && npm cache clean --force
COPY ai-service/src ./ai-service/src

# Dashboard static files
COPY --from=dashboard-builder /app/dist /usr/share/nginx/html

# Nginx + startup
COPY deploy/nginx.coolify.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default
COPY deploy/start-coolify.sh /start-coolify.sh
RUN chmod +x /start-coolify.sh

RUN mkdir -p /app/data/sessions /app/data/media

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD wget -qO- http://127.0.0.1/api/health > /dev/null 2>&1 || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["/start-coolify.sh"]
