# =============================================================================
# OpenWA — variabili per deploy su Coolify
# =============================================================================
# In Coolify NON serve caricare un file .env: incolla queste variabili
# nella sezione "Environment Variables" dell'applicazione.
#
# Build consigliato:
#   Dockerfile Location → /Dockerfile.coolify
#   Ports Exposes       → 80
#   Port Mappings       → (vuoto)
#   Persistent Storage  → /app/data
#
# IMPORTANTE — PORT e Coolify:
#   Coolify richiede che PORT corrisponda a "Ports Exposes".
#   Imposta PORT=80 (nginx). NON usare PORT=2785 qui.
#   L'API (2785) e l'AI (3100) partono su porte interne via start-coolify.sh.
# =============================================================================

# ── OBBLIGATORIA ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXX

# ── Proxy Coolify (deve coincidere con Ports Exposes = 80) ───────────────────
PORT=80

# ── API OpenWA ───────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Database SQLite (persistente su volume /app/data)
DATABASE_TYPE=sqlite
DATABASE_NAME=/app/data/openwa.sqlite
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Motore WhatsApp
ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=/app/data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# Storage media
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/media

# Sicurezza API (consigliato in produzione — usala anche per login dashboard)
API_MASTER_KEY=cambia-questa-chiave-segreta-lunga

# ── AI Service ───────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=cambia-questa-chiave-segreta-lunga
HISTORY_LIMIT=30
REPLY_LANGUAGE=italiano
SYSTEM_PROMPT_EXTRA=

# ── Opzionali ────────────────────────────────────────────────────────────────
# Webhook
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000

# Redis / coda (disabilitati per setup semplice)
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false

# Plugin
PLUGINS_ENABLED=true
PLUGINS_DIR=/app/data/plugins

# CORS (il dominio Coolify è già dietro proxy)
CORS_ORIGINS=*
