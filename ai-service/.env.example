# AI Service Environment
# Copia questo file in .env e compilalo

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# OpenWA API
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=dev-admin-key

# Questo servizio
PORT=3100

# Quanti messaggi di storia caricare per ogni conversazione
HISTORY_LIMIT=30

# Lingua preferita per le suggerimenti (es: italiano, english)
REPLY_LANGUAGE=italiano

# Prompt di sistema personalizzato (opzionale, lascia vuoto per usare il default)
SYSTEM_PROMPT_EXTRA=
